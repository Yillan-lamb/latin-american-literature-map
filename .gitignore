.DS_Store
.env
.env.*
!.env.example

# 用户提供的书籍和私有研究材料不得进入公开仓库
sources/private/
private/
inputs/private/
work/
handoffs/incoming/

# Internal project management, reasoning and AI working state
project/internal/

# Local tool configuration (ignore only these exact files)
/.mcp.json
/.codebuddy/settings.local.json

*.pdf
*.epub
*.mobi
*.azw
*.azw3

# 外部 AI 任务包可能包含原始书籍、整书 OCR 和本地中间产物
N1-OCR-*/
N1-OCR-*.zip

# 本地数据库临时文件和 Agent 会话状态
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
.claude/agent-sessions/
.workbuddy/
__pycache__/
node_modules/
dist/

# 可复现 QA 的原始工件由 CI 保存；本地运行目录不提交
artifacts/v2-rc4/browser/failures/
artifacts/v2-rc4/browser/html/
artifacts/v2-rc4/lighthouse/*.html
