    {"target_id":"V1-ENT-0263","story_intro":{"content":"《特拉特洛尔科之夜》（La noche de Tlatelolco）是埃莱娜·波尼亚托夫斯卡 1971 年的作品，UNAM 资料将它与 1968 年学生事件联系起来。","status":"user_review","research_refs":["V1-FCT-0652","V1-FCT-0653","V1-FCT-0654"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"why_read":{"content":["先核对 1971 年书目位置。","再观察公共事件如何通过人物声音进入文本。"],"status":"user_review","research_refs":["V1-FCT-0653","V1-FCT-0654"],"source_refs":["SRC-0207"],"reviewer":"UNREVIEWED"},"theme_explanations":{"content":["公共事件与书目记录"],"status":"user_review","research_refs":["V1-FCT-0654"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"next_reads":{"content":[{"target_id":"V1-ENT-0264","reason":"继续读 Poniatowska 的小说书目"},{"target_id":"V1-ENT-0265","reason":"对照 Tinísima 的年份冲突"}],"status":"user_review","research_refs":["V1-REL-0189","V1-REL-0190"],"source_refs":["SRC-0205","SRC-0206"],"reviewer":"UNREVIEWED"},"location_note":{"content":"研究层只保留作者与墨西哥的国家关联，不为作品故事地点补造坐标。","status":"user_review","research_refs":["V1-REL-0197"],"source_refs":["SRC-0207"],"reviewer":"UNREVIEWED"},"reading_approach":{"content":"先记录 1971 年书目，再把文本中的公共声音与个人叙述分开阅读。","status":"user_review","research_refs":["V1-FCT-0653","V1-FCT-0654"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"公共事件如何通过不同人物的声音进入《特拉特洛尔科之夜》？","status":"user_review","research_refs":["V1-FCT-0652","V1-FCT-0654"],"source_refs":["SRC-0206"],"reviewer":"UNREVIEWED"}},
