    {"target_id":"V1-ENT-0265","story_intro":{"content":"《蒂娜》（Tinísima）是埃莱娜·波尼亚托夫斯卡的作品；两份机构页面分别记录 1991 与 1992，当前保留冲突。","status":"user_review","research_refs":["V1-FCT-0658","V1-FCT-0659","V1-FCT-0660"],"source_refs":["SRC-0205","SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"why_read":{"content":["先查看 1991/1992 的并列记录。","再把人物传记线索与作者书目区分开。"],"status":"user_review","research_refs":["V1-FCT-0659","V1-FCT-0660"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"theme_explanations":{"content":["传记题材与年份核对"],"status":"user_review","research_refs":["V1-FCT-0660"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"next_reads":{"content":[{"target_id":"V1-ENT-0263","reason":"回到 1971 年公共写作"},{"target_id":"V1-ENT-0264","reason":"对照 1969 年小说节点"}],"status":"user_review","research_refs":["V1-REL-0188","V1-REL-0189"],"source_refs":["SRC-0205","SRC-0206"],"reviewer":"UNREVIEWED"},"location_note":{"content":"研究层只保留作者与墨西哥的国家关联，不为传记题材自动伪造现实坐标。","status":"user_review","research_refs":["V1-REL-0197"],"source_refs":["SRC-0207"],"reviewer":"UNREVIEWED"},"reading_approach":{"content":"先记录两份机构年份，再进入文本并把待复核的书目冲突保持可见。","status":"user_review","research_refs":["V1-FCT-0659","V1-FCT-0660"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"当机构资料给出两个年份时，读者如何带着这个不确定性进入《蒂娜》？","status":"user_review","research_refs":["V1-FCT-0659","V1-FCT-0660"],"source_refs":["SRC-0206","SRC-0207"],"reviewer":"UNREVIEWED"}},
