    {"target_id":"V1-ENT-0284","reader_lede":{"content":"曼努埃尔·普伊格的作者入口从阿根廷小说、电影经验与大众文化的交界展开；三部作品的书目年份先构成一条可检索的时间线。","status":"user_review","research_refs":["V1-FCT-0732","V1-FCT-0735","V1-FCT-0738"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"why_know":{"content":"普伊格的三部小说把作者的作品目录、出版年代与读者熟悉的中文入口连在一起，适合先从书目事实进入，再等待更细的阅读说明。","status":"user_review","research_refs":["V1-FCT-0740","V1-FCT-0744","V1-FCT-0748"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"literary_features":{"content":["小说、剧本与戏剧身份并置","三部作品跨越 1968—1976 年","中文展示名与原文题名并列"],"status":"user_review","research_refs":["V1-FCT-0736","V1-FCT-0740","V1-FCT-0744"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"core_themes":{"content":["大众文化与小说书目","作者身份与作品形式","出版年代与阅读入口"],"status":"user_review","research_refs":["V1-FCT-0736","V1-FCT-0740","V1-FCT-0748"],"source_refs":["SRC-0225"],"reviewer":"UNREVIEWED"},"start_here":{"content":["《蜘蛛女之吻》","《丽塔·海华丝的背叛》","《红唇》"],"status":"user_review","research_refs":["V1-FCT-0738","V1-FCT-0740","V1-FCT-0744"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"reader_fit":{"content":"如果你想从一位阿根廷作者的作品目录进入电影经验与小说形式，普伊格的三部作品提供了清晰而可继续核验的阅读坐标。","status":"user_review","research_refs":["V1-FCT-0732","V1-FCT-0736","V1-FCT-0748"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"signature_keywords":{"content":["阿根廷","小说与电影","大众文化"],"status":"user_review","research_refs":["V1-FCT-0736","V1-FCT-0740"],"source_refs":["SRC-0225"],"reviewer":"UNREVIEWED"},"reading_route":{"content":["先定位《丽塔·海华丝的背叛》的 1968 年书目","再比较《红唇》的 1969 年记录","最后进入 1976 年的《蜘蛛女之吻》"],"status":"user_review","research_refs":["V1-FCT-0740","V1-FCT-0744","V1-FCT-0738"],"source_refs":["SRC-0225","SRC-0226"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"当电影和大众文化进入小说目录时，普伊格的作品年代怎样改变阅读顺序？","status":"user_review","research_refs":["V1-FCT-0736","V1-FCT-0740"],"source_refs":["SRC-0225"],"reviewer":"UNREVIEWED"}},
    {"target_id":"V1-ENT-0285","reader_lede":{"content":"西尔维娜·奥坎波的作者入口以短篇小说、诗歌和翻译三种身份为起点；机构资料也清楚列出她几个重要故事集的出版年份。","status":"user_review","research_refs":["V1-FCT-0750","V1-FCT-0753","V1-FCT-0756"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"why_know":{"content":"奥坎波的三部故事集跨越 1937—1961 年，中文展示名、原文题名与作品层级可以先帮助读者建立进入路径，较强的风格判断留待后续核实。","status":"user_review","research_refs":["V1-FCT-0759","V1-FCT-0763","V1-FCT-0767"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"literary_features":{"content":["短篇小说与诗歌并行","三部故事集的年代跨度","机构书目与中文展示名并列"],"status":"user_review","research_refs":["V1-FCT-0750","V1-FCT-0759","V1-FCT-0763"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"core_themes":{"content":["短篇集的书目路径","儿童与日常经验的研究线索","作品年代与阅读顺序"],"status":"user_review","research_refs":["V1-FCT-0750","V1-FCT-0759","V1-FCT-0767"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"start_here":{"content":["《被遗忘的旅程》","《愤怒》","《邀请》"],"status":"user_review","research_refs":["V1-FCT-0759","V1-FCT-0763","V1-FCT-0767"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"reader_fit":{"content":"如果你希望从阿根廷短篇传统和诗歌身份的交叉处开始，奥坎波的三部故事集提供了按年代推进的中文阅读入口。","status":"user_review","research_refs":["V1-FCT-0750","V1-FCT-0753","V1-FCT-0763"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"signature_keywords":{"content":["阿根廷","短篇小说","诗歌与翻译"],"status":"user_review","research_refs":["V1-FCT-0750","V1-FCT-0753"],"source_refs":["SRC-0227"],"reviewer":"UNREVIEWED"},"reading_route":{"content":["先看《被遗忘的旅程》的 1937 年书目位置","再进入 1959 年的《愤怒》","最后比较 1961 年《邀请》的作品层级"],"status":"user_review","research_refs":["V1-FCT-0759","V1-FCT-0763","V1-FCT-0767"],"source_refs":["SRC-0227","SRC-0228"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"当短篇故事集跨越不同年代时，奥坎波的中文阅读入口应如何保持作品层级的清楚？","status":"user_review","research_refs":["V1-FCT-0759","V1-FCT-0763"],"source_refs":["SRC-0227"],"reviewer":"UNREVIEWED"}},
    {"target_id":"V1-ENT-0286","reader_lede":{"content":"罗贝托·阿尔特的作者入口连接小说、新闻与戏剧；国家图书馆和国会图书馆的年表共同确认了三部小说的出版顺序。","status":"user_review","research_refs":["V1-FCT-0769","V1-FCT-0772","V1-FCT-0775"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"why_know":{"content":"从 1926 年的《疯玩具》到 1931 年的《火焰喷射器》，阿尔特的作品目录提供了一条早期阿根廷都市小说的时间线，但更强的文学史判断仍保留在审核层。","status":"user_review","research_refs":["V1-FCT-0778","V1-FCT-0782","V1-FCT-0781"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"literary_features":{"content":["小说、新闻与戏剧身份并置","1926—1931 年的连续出版节点","三部作品的原文题名与中文标签并列"],"status":"user_review","research_refs":["V1-FCT-0769","V1-FCT-0778","V1-FCT-0782"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"core_themes":{"content":["都市生活的研究线索","小说与新闻的相邻位置","出版顺序与阅读入口"],"status":"user_review","research_refs":["V1-FCT-0772","V1-FCT-0778","V1-FCT-0781"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"start_here":{"content":["《疯玩具》","《七个疯子》","《火焰喷射器》"],"status":"user_review","research_refs":["V1-FCT-0778","V1-FCT-0782","V1-FCT-0781"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"reader_fit":{"content":"如果你想沿一条清晰的出版时间线进入阿根廷小说与新闻写作，阿尔特的三部作品能够提供从 1926 年到 1931 年的连续坐标。","status":"user_review","research_refs":["V1-FCT-0769","V1-FCT-0772","V1-FCT-0782"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"signature_keywords":{"content":["阿根廷","都市小说","新闻与戏剧"],"status":"user_review","research_refs":["V1-FCT-0769","V1-FCT-0772"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"reading_route":{"content":["先从《疯玩具》的 1926 年书目开始","再进入 1929 年的《七个疯子》","最后沿 1931 年《火焰喷射器》继续"],"status":"user_review","research_refs":["V1-FCT-0778","V1-FCT-0782","V1-FCT-0781"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"当小说与新闻经验相邻出现时，阿尔特的出版顺序怎样帮助读者进入都市文学？","status":"user_review","research_refs":["V1-FCT-0769","V1-FCT-0772"],"source_refs":["SRC-0229","SRC-0230"],"reviewer":"UNREVI