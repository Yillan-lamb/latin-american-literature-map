    {"target_id":"V1-ENT-0309","reader_lede":{"content":"卡洛斯·德鲁蒙德·德·安德拉德的入口以巴西国家图书馆身份记录和 ABL 的诗集年表为骨架；三部诗集把 1930、1945、1951 三个节点并列出来。","status":"user_review","research_refs":["V1-FCT-0829","V1-FCT-0832","V1-FCT-0835"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"why_know":{"content":"从《某种诗》到《人民的玫瑰》再到《明晰之谜》，读者可以先沿诗集年份进入，再把现代主义或政治诗的强判断留给后续审核。","status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"literary_features":{"content":["作者身份与诗集层级清楚分开","三部诗集形成 21 年时间跨度","巴西葡语原文题名保留"],"status":"user_review","research_refs":["V1-FCT-0829","V1-FCT-0832","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"core_themes":{"content":["诗集书目与年代进入","国家图书馆身份记录","诗歌形式的中文展示状态"],"status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"start_here":{"content":["《某种诗》","《人民的玫瑰》","《明晰之谜》"],"status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"reader_fit":{"content":"如果你想从巴西现代诗的书目年表开始，德鲁蒙德的三部诗集提供了逐步推进而不预设文学评价的入口。","status":"user_review","research_refs":["V1-FCT-0829","V1-FCT-0832","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"signature_keywords":{"content":["巴西诗歌","诗集年表","现代诗入口"],"status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835"],"source_refs":["SRC-0243"],"reviewer":"UNREVIEWED"},"reading_route":{"content":["先从 1930 年《某种诗》定位作者的首部诗集","再进入 1945 年《人民的玫瑰》","最后比较 1951 年《明晰之谜》"],"status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835","V1-FCT-0838"],"source_refs":["SRC-0243","SRC-0244"],"reviewer":"UNREVIEWED"},"guiding_question":{"content":"三部诗集的出版节点如何让读者在不先下文学史结论的情况下进入德鲁蒙德？","status":"user_review","research_refs":["V1-FCT-0832","V1-FCT-0835"],"source_refs":["SRC-0243"],"reviewer":"UNREVIEWED"}},
